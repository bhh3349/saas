# saas-service 环境变量（复制为 .env 使用；生产环境必须修改默认密钥）

# 服务端口
PORT=3200

# SQLite 数据库路径（相对项目根目录）
DB_PATH=data/saas.db

# JWT 密钥与有效期
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=8h

# 平台端内部接口（注册链路调用，必须与 platform-service 的 INTERNAL_SHARED_SECRET 一致）
PLATFORM_INTERNAL_BASE_URL=http://127.0.0.1:3100
PLATFORM_INTERNAL_SECRET=dev-internal-secret

# 注册时默认创建的桌台数量
DEFAULT_TABLE_COUNT=10
