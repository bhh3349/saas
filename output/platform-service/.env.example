# ── 服务 ──────────────────────────────────────────────
PORT=3100
# development | production
NODE_ENV=development

# ── 数据库 ────────────────────────────────────────────
DB_PATH=data/platform.db
# 生产环境请保持 false，schema 变更走 migration（npm run migration:generate / migration:run）
DB_SYNC=false

# ── 安全（生产环境必改，密钥长度 ≥ 32 位）─────────────
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=please-generate-32-byte-random-hex
INTERNAL_SHARED_SECRET=please-generate-32-byte-random-hex
SAAS_INTERNAL_SECRET=please-generate-32-byte-random-hex

# ── CORS 白名单（逗号分隔多个来源）───────────────────
CORS_ORIGINS=https://admin.your-domain.com

# ── 种子运营账号 ─────────────────────────────────────
# 密码留空时：自动生成随机密码，仅启动日志打印一次
SEED_OPERATOR_USERNAME=admin
# SEED_OPERATOR_PASSWORD=please-set-a-strong-password

# ── 对接 saas-service ────────────────────────────────
SAAS_INTERNAL_BASE_URL=http://127.0.0.1:3200
