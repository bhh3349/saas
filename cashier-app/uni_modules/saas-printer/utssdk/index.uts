/**
 * saas-printer 跨平台入口
 *
 * Android 平台：转发到 utssdk/app-android/index.uts 的原生实现
 * 其他平台：返回不支持错误
 *
 * 注意：UTS 的 Promise then 回调不支持返回值/返回 Promise（5.24 编译器），
 * 所有链式调用一律改写为 async/await 包装函数。
 */

// #ifdef APP-ANDROID
import {
  sendBluetooth as _sendBluetooth,
  sendTcp as _sendTcp,
  isBluetoothEnabled as _isBt,
  getPairedDevices as _getPaired,
  startBluetoothScan as _scanBt,
  ensureBluetoothReady as _ensureBtReady,
  requestPermissions as _requestPermissions,
  openPermissionSettings as _openPermissionSettings,
  type BtDevice,
} from './app-android/index.uts'
// #endif

/** 发送结果 */
export type SendResult = {
  success: boolean
  message: string
}

/** 通用权限申请结果（跨平台别名） */
export type PermissionResult = {
  /** 是否全部授予 */
  granted: boolean
  /** 未授予的权限列表 */
  deniedList: Array<string>
  /** 用户是否勾选了「不再询问」（true 时应引导跳转系统设置） */
  doNotAskAgain: boolean
  /** granted = false 时可直接展示给用户的引导文案 */
  message: string
}

/** 原生结果 → 入口 PermissionResult 拷贝（跨编译单元类型不一致，需逐字段转） */
async function requestPermsResult(permissions: Array<string>): Promise<PermissionResult> {
  const r = await _requestPermissions(permissions)
  return {
    granted: r.granted,
    deniedList: r.deniedList,
    doNotAskAgain: r.doNotAskAgain,
    message: r.message,
  } as PermissionResult
}

/**
 * 通用动态权限申请（蓝牙 / GPS / 相机等原生能力共用）。
 * granted = false 时 message 为可直接展示的引导文案；
 * doNotAskAgain = true 时可接着调用 openPermissionSettings(permissions) 跳系统设置。
 */
export function requestPermissions(permissions: Array<string>): Promise<PermissionResult> {
  // #ifdef APP-ANDROID
  return requestPermsResult(permissions)
  // #endif
  // #ifndef APP-ANDROID
  return Promise.resolve({ granted: false, deniedList: permissions, doNotAskAgain: false, message: '当前平台暂不支持原生权限申请' } as PermissionResult)
  // #endif
}

/** 跳转本应用的系统权限设置页（permissions 为相关权限列表，如 ['android.permission.CAMERA']） */
export function openPermissionSettings(permissions: Array<string>): void {
  // #ifdef APP-ANDROID
  _openPermissionSettings(permissions)
  // #endif
  // #ifndef APP-ANDROID
  // 其他平台无系统权限设置页可跳
  // #endif
}

/** 蓝牙设备信息（跨平台别名） */
export type BluetoothDeviceInfo = {
  name: string
  mac: string
  /** 是否已配对（未配对设备连接时会触发系统配对弹窗） */
  bonded: boolean
}

/** 蓝牙发送（async 包装，错误转 SendResult） */
async function sendBtResult(address: string, bytes: Uint8Array, timeout: number): Promise<SendResult> {
  try {
    await _sendBluetooth(address, bytes, timeout)
    return { success: true, message: '发送成功' } as SendResult
  } catch (e) {
    return { success: false, message: (e as Error).message } as SendResult
  }
}

/** WiFi 发送（async 包装） */
async function sendTcpResult(address: string, port: number, bytes: Uint8Array, timeout: number): Promise<SendResult> {
  try {
    await _sendTcp(address, port, bytes, timeout)
    return { success: true, message: '发送成功' } as SendResult
  } catch (e) {
    return { success: false, message: (e as Error).message } as SendResult
  }
}

/** 统一入口：根据 type 自动选择通道 */
export function sendBytes(type: string, address: string, port: number, bytes: Uint8Array, timeout: number = 5000): Promise<SendResult> {
  // #ifdef APP-ANDROID
  if (type == 'bluetooth') {
    return sendBtResult(address, bytes, timeout)
  }
  if (type == 'wifi') {
    return sendTcpResult(address, port, bytes, timeout)
  }
  return Promise.resolve({ success: false, message: '未知连接方式: ' + type } as SendResult)
  // #endif

  // #ifndef APP-ANDROID
  return Promise.resolve({ success: false, message: '当前平台暂不支持打印' } as SendResult)
  // #endif
}

/**
 * 蓝牙就绪检查：动态申请蓝牙权限（Android 12+）并校验蓝牙开关。
 * @returns '' 表示就绪，否则返回可直接展示给用户的错误提示
 */
export function ensureBluetoothReady(): Promise<string> {
  // #ifdef APP-ANDROID
  return _ensureBtReady()
  // #endif
  // #ifndef APP-ANDROID
  return Promise.resolve('当前平台暂不支持蓝牙')
  // #endif
}

export function isBluetoothEnabled(): boolean {
  // #ifdef APP-ANDROID
  return _isBt()
  // #endif
  // #ifndef APP-ANDROID
  return false
  // #endif
}

/** BtDevice → BluetoothDeviceInfo 拷贝 */
function copyDevices(src: Array<BtDevice>): Array<BluetoothDeviceInfo> {
  const dst: Array<BluetoothDeviceInfo> = []
  for (let i = 0; i < src.length; i++) {
    const s = src[i] as BtDevice
    const d = { name: s.name, mac: s.mac, bonded: s.bonded } as BluetoothDeviceInfo
    dst.push(d)
  }
  return dst
}

/** 获取已配对蓝牙设备列表 */
export function getPairedBluetooth(): Array<BluetoothDeviceInfo> {
  // #ifdef APP-ANDROID
  return copyDevices(_getPaired())
  // #endif
  // #ifndef APP-ANDROID
  return []
  // #endif
}

/**
 * 扫描附近蓝牙设备（经典蓝牙发现，约 12s）。
 * Android 12+ 首次调用会触发权限申请弹窗（BLUETOOTH_SCAN / CONNECT）。
 * 返回结果含已配对设备（bonded = true）。
 */
export function scanBluetoothDevices(): Promise<Array<BluetoothDeviceInfo>> {
  // #ifdef APP-ANDROID
  return scanBtResult()
  // #endif
  // #ifndef APP-ANDROID
  return Promise.resolve([] as Array<BluetoothDeviceInfo>)
  // #endif
}

/** 扫描（async 包装，错误转空数组 + 由调用方 toast 呈现的异常走 reject） */
async function scanBtResult(): Promise<Array<BluetoothDeviceInfo>> {
  const src = await _scanBt()
  return copyDevices(src)
}
