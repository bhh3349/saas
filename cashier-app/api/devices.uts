/**
 * 收银端设备心跳接口
 * 设备由心跳自动登记 / 更新，商家后台「设备监控」页只读展示
 * POST /devices/heartbeat（老板 / 收银员可用）
 */
import { request, getToken } from '../utils/request.uts'

export type HeartbeatResult = {
  device_id: string
  last_seen_at: string
}

/** 心跳上报载荷（具名类型，避免匿名对象字面量在编译器生成代码时出问题） */
export type HeartbeatInput = {
  device_id: string
  name?: string
  type?: string
  location?: string
  ip?: string
  mac?: string
  os?: string
  app_version?: string
}

/** 收银端应用版本（发布时与 manifest.json 的 versionName 同步） */
const APP_VERSION = '1.0.0'

const DEVICE_ID_KEY = 'device_id'

/** 读取稳定设备标识：首次生成并持久化到本地，同一台设备保持不变 */
function getDeviceId(): string {
  let id = (uni.getStorageSync(DEVICE_ID_KEY) as string) ?? ''
  if (id.length === 0) {
    id = 'pos-' + Date.now().toString(36) + '-' + randomToken(12)
    uni.setStorageSync(DEVICE_ID_KEY, id)
  }
  return id
}

/** 生成小写字母 + 数字随机串 */
function randomToken(len: number): string {
  const chars = 'abcdefghijklmnopqrstuvwxyz0123456789'
  let out = ''
  for (let i = 0; i < len; i++) {
    const idx = Math.floor(Math.random() * chars.length)
    out += chars.substring(idx, idx + 1)
  }
  return out
}

/**
 * 上报心跳（自动登记 / 更新设备）。
 * 未登录直接跳过；失败静默（心跳不阻塞业务、不弹提示，
 * 网络异常时由商家后台按「超过 5 分钟无心跳 = 离线」展示）。
 */
export function sendHeartbeat(): Promise<HeartbeatResult | null> {
  return new Promise<HeartbeatResult | null>((resolve) => {
    if (getToken().length === 0) {
      resolve(null)
      return
    }
    const info = uni.getSystemInfoSync()
    const payload: HeartbeatInput = {
      device_id: getDeviceId(),
      name: info.deviceModel,
      type: 'POS',
      os: info.osName + ' ' + info.osVersion,
      app_version: APP_VERSION,
    }
    request<HeartbeatResult>({
      url: '/devices/heartbeat',
      method: 'POST',
      data: payload,
    })
      .then((res) => {
        resolve(res)
      })
      .catch((_e) => {
        resolve(null)
      })
  })
}
