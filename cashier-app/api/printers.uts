/**
 * 打印机接口
 */
import { request } from '../utils/request.uts'

export type PrinterItem = {
  id: number
  name: string
  type: string // bluetooth | wifi
  address: string
  port: number
  brand: string
  width_mm: number
  is_default: boolean
  remark: string
  enabled: boolean
  created_at: string
  updated_at: string
}

export type CreatePrinterInput = {
  name: string
  type: string
  address: string
  port?: number
  brand?: string
  width_mm?: number
  is_default?: boolean
  remark?: string
  enabled?: boolean
}

/** 列出本店全部打印机 */
export function fetchPrinters(): Promise<PrinterItem[]> {
  return new Promise<PrinterItem[]>((resolve, reject) => {
    request<UTSJSONObject>({ url: '/printers', method: 'GET', raw: true })
      .then((body) => {
        const arr = body.getArray('data')
        const out: PrinterItem[] = []
        if (arr != null) {
          for (let i = 0; i < arr.length; i++) {
            const obj = arr[i] as UTSJSONObject
            if (obj != null) {
              const item: PrinterItem = {
                id: (obj['id'] as number) ?? 0,
                name: (obj['name'] as string) ?? '',
                type: (obj['type'] as string) ?? 'wifi',
                address: (obj['address'] as string) ?? '',
                port: (obj['port'] as number) ?? 0,
                brand: (obj['brand'] as string) ?? '',
                width_mm: (obj['width_mm'] as number) ?? 80,
                is_default: (obj['is_default'] as boolean) ?? false,
                remark: (obj['remark'] as string) ?? '',
                enabled: (obj['enabled'] as boolean) ?? true,
                created_at: (obj['created_at'] as string) ?? '',
                updated_at: (obj['updated_at'] as string) ?? '',
              }
              out.push(item)
            }
          }
        }
        resolve(out)
      })
      .catch((err) => {
        reject(err)
      })
  })
}

/** 新增打印机 */
export function createPrinter(dto: CreatePrinterInput): Promise<PrinterItem> {
  return request<PrinterItem>({
    url: '/printers',
    method: 'POST',
    data: dto,
  })
}

/** 修改打印机 */
export function updatePrinter(id: number, dto: Partial<CreatePrinterInput>): Promise<PrinterItem> {
  return request<PrinterItem>({
    url: '/printers/' + id.toString(),
    method: 'PUT',
    data: dto,
  })
}

/** 删除打印机 */
export function deletePrinter(id: number): Promise<void> {
  return request<void>({
    url: '/printers/' + id.toString(),
    method: 'DELETE',
  })
}

/** 设为默认打印机（单选） */
export function setDefaultPrinter(id: number): Promise<void> {
  return request<void>({
    url: '/printers/' + id.toString() + '/default',
    method: 'POST',
  })
}
