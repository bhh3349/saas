<template>
  <view class="login-page">
    <!-- 品牌区 -->
    <view class="brand">
      <text class="brand-title">收银台</text>
      <text class="brand-sub">餐饮收银系统</text>
    </view>

    <!-- 表单 -->
    <view class="form">
      <input
        class="input"
        type="tel"
        v-model="phone"
        placeholder="请输入手机号"
        :maxlength="11"
      />
      <input
        class="input"
        type="password"
        v-model="password"
        placeholder="请输入密码"
      />
      <button class="login-btn" :class="loading ? 'login-btn-disabled' : ''" :disabled="loading" @click="onLogin">
        {{ loading ? '登录中…' : '登 录' }}
      </button>
      <view class="register-link" @click="toRegister">
        <text class="register-link-text">还没有店铺？去注册</text>
      </view>
      <text v-if="error" class="error">{{ error }}</text>
    </view>
  </view>
</template>

<script>
  import { login } from '../../api/auth.uts'
  import { setToken } from '../../utils/request.uts'

  export default {
    data() {
      return {
        phone: '',
        password: '',
        loading: false,
        error: ''
      }
    },
    onLoad() {
      // 已登录直接进入工作台
      const token = uni.getStorageSync('token')
      if (token) {
        uni.reLaunch({ url: '/pages/home/index' })
      }
    },
    methods: {
      async onLogin() {
        this.error = ''
        if (this.phone == '' || this.phone.length != 11) {
          this.error = '请输入正确的手机号'
          return
        }
        if (this.password == '') {
          this.error = '请输入密码'
          return
        }
        this.loading = true
        try {
          const res = await login(this.phone, this.password)
          setToken(res.token)
          uni.setStorageSync('user', JSON.stringify(res.user))
          uni.reLaunch({ url: '/pages/home/index' })
        } catch (e) {
          this.error = (e.message as string) ?? ''
        } finally {
          this.loading = false
        }
      },
      toRegister() {
        uni.navigateTo({ url: '/pages/register/index' })
      }
    }
  }
</script>

<style>
  .login-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    height: 100%;
    background-color: #ffffff;
    padding: 0 40rpx;
    box-sizing: border-box;
  }

  .brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 180rpx;
    margin-bottom: 100rpx;
  }

  .brand-title {
    font-size: 64rpx;
    font-weight: bold;
    color: #ff6a00;
  }

  .brand-sub {
    margin-top: 16rpx;
    font-size: 30rpx;
    color: #999999;
  }

  .form {
    width: 100%;
  }

  .input {
    width: 100%;
    height: 100rpx;
    padding: 0 32rpx;
    box-sizing: border-box;
    background-color: #f5f6f8;
    border-radius: 16rpx;
    font-size: 32rpx;
    color: #333333;
    margin-bottom: 32rpx;
  }

  .login-btn {
    width: 100%;
    height: 96rpx;
    line-height: 96rpx;
    margin-top: 16rpx;
    background-color: #ff6a00;
    color: #ffffff;
    font-size: 36rpx;
    border-radius: 16rpx;
    border: none;
  }

  .login-btn-disabled {
    opacity: 0.6;
  }

  .register-link {
    margin-top: 32rpx;
    text-align: center;
  }

  .register-link-text {
    font-size: 28rpx;
    color: #ff6a00;
  }

  .error {
    display: flex;
    margin-top: 24rpx;
    font-size: 26rpx;
    color: #f5222d;
    text-align: center;
  }
</style>
