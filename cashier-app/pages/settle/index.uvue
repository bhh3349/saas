<template>
  <view class="page">
    <!-- 顶部导航 -->
    <view class="nav" :style="{ paddingTop: statusBarHeight + 'px' }">
      <view class="nav-inner">
        <view class="nav-back" @click="goBack">
          <text class="back-icon">←</text>
        </view>
        <text class="nav-title">结账</text>
        <view class="nav-right"></view>
      </view>
    </view>

    <!-- 可滚动主体：账单 + 支付方式 + 收银键盘 -->
    <scroll-view class="body-scroll" scroll-y>
      <!-- 订单信息 -->
      <view class="table-info">
        <text class="table-info-text">订单号：{{ order ? order.order_no : '-' }}</text>
        <text class="order-no">{{ order && order.mode == 'table' ? '桌台模式' : '叫号模式' }}</text>
      </view>

    <!-- 账单明细 -->
    <view class="bill-section">
      <text class="bill-title">账单明细</text>

      <view v-for="(item, i) in (order && order.items) ? order.items : []" :key="i" class="bill-item">
        <text class="bill-item-name">{{ item.name }}<text v-if="item.spec_name" class="bill-item-spec">（{{ item.spec_name }}）</text></text>
        <text class="bill-item-qty">×{{ item.qty }}</text>
        <text class="bill-item-amount">¥{{ item.amount.toFixed(2) }}</text>
      </view>

      <view class="bill-divider"></view>

      <view class="bill-sub-row">
        <text class="bill-sub-label">菜品价格合计</text>
        <text class="bill-sub-value">¥{{ order ? order.total_amount.toFixed(2) : '0.00' }}</text>
      </view>

      <view v-if="discountAmount > 0" class="bill-sub-row">
        <text class="bill-sub-label">优惠</text>
        <text class="bill-sub-value neg">-¥{{ discountAmount.toFixed(2) }}</text>
      </view>

      <view class="bill-total-row">
        <text class="bill-total-label">应收</text>
        <text class="bill-total-amount">¥{{ payableAmount.toFixed(2) }}</text>
      </view>
    </view>

    <!-- 整单优惠：抹零 / 快捷折扣 / 自定义 -->
    <view class="opt-card">
      <view class="card-title-row">
        <text class="card-title">整单优惠</text>
        <text v-if="discountAmount > 0" class="card-title-sub">已优惠 -¥{{ discountAmount.toFixed(2) }}</text>
      </view>
      <view class="quick-row">
        <view class="quick-chip" :class="{ 'quick-chip-exact': manualDiscount > 0 }" @click="toggleMolin">
          <text v-if="manualDiscount > 0" class="quick-chip-exact-text">已抹零</text>
          <text v-else class="quick-chip-text">抹零</text>
        </view>
        <view
          v-for="d in discountOptions"
          :key="d.key"
          class="quick-chip"
          :class="{ 'quick-chip-exact': discountPercent == d.value }"
          @click="toggleDiscount(d.value)"
        >
          <text class="quick-chip-text" :class="{ 'quick-chip-exact-text': discountPercent == d.value }">{{ d.label }}</text>
        </view>
        <view
          class="quick-chip"
          :class="{ 'quick-chip-exact': discountPanelVisible }"
          @click="toggleDiscountPanel"
        >
          <text class="quick-chip-text" :class="{ 'quick-chip-exact-text': discountPanelVisible }">自定义</text>
        </view>
      </view>
      <view v-if="discountPanelVisible" class="discount-custom-panel">
        <view class="discount-custom-row">
          <text class="discount-custom-label">折扣率</text>
          <input
            class="discount-custom-input"
            type="number"
            v-model="customDiscountText"
            placeholder="5.0-9.9"
            :maxlength="3"
          />
          <text class="discount-custom-unit">折</text>
        </view>
        <view class="discount-custom-row">
          <text class="discount-custom-label">原因</text>
          <input
            class="discount-custom-input"
            type="text"
            v-model="customDiscountReason"
            placeholder="会员日"
            :maxlength="12"
          />
        </view>
        <view class="discount-custom-hint-row">
          <text class="discount-custom-hint">{{ customDiscountHint }}</text>
          <view
            class="discount-custom-action"
            :class="{ 'discount-custom-action-on': canApplyCustomDiscount }"
            @click="applyCustomDiscount"
          >
            <text class="discount-custom-action-text" :class="{ 'discount-custom-action-text-on': canApplyCustomDiscount }">应用</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 拆分支付：多支付方式叠加 -->
    <view class="opt-card">
      <view class="card-title-row">
        <text class="card-title">拆分支付</text>
        <text class="card-title-sub">多种支付方式组合收款</text>
      </view>

      <view v-for="row in splitRows" :key="row.key" class="split-row">
        <view class="split-method" @click="openMethodPanel(row)">
          <text class="split-method-icon">{{ methodIcon(row.methodId) }}</text>
          <text class="split-method-name">{{ methodName(row.methodId) }}</text>
          <text class="split-method-arrow">▾</text>
        </view>
        <view class="split-amount" :class="{ 'split-amount-auto': row.amount == null }" @click="openAmountPanel(row)">
          <text class="split-amount-text" :class="{ 'split-amount-text-auto': row.amount == null }">{{ rowAmountText(row) }}</text>
        </view>
        <view v-if="splitRows.length > 1" class="split-del" @click="removeRow(row.key)">
          <text class="split-del-text">✕</text>
        </view>
      </view>

      <view class="split-add-wrap">
        <view class="split-add" :class="{ 'split-add-disabled': !canAddRow }" @click="addRow">
          <text class="split-add-text">+ 添加支付方式</text>
        </view>
      </view>

      <!-- 实时收款汇总 -->
      <view class="split-summary">
        <view class="split-sum-col">
          <text class="split-sum-label">已收合计</text>
          <text class="split-sum-value">¥{{ receivedAmount.toFixed(2) }}</text>
        </view>
        <view v-if="unpaidAmount > 0" class="split-sum-col split-sum-warn">
          <text class="split-sum-label">未收（补足才能结账）</text>
          <text class="split-sum-value split-sum-warn-value">¥{{ unpaidAmount.toFixed(2) }}</text>
        </view>
        <view v-else-if="changeAmount > 0" class="split-sum-col split-sum-ok">
          <text class="split-sum-label">找零</text>
          <text class="split-sum-value split-sum-ok-value">¥{{ changeAmount.toFixed(2) }}</text>
        </view>
        <view v-else class="split-sum-col split-sum-ok">
          <text class="split-sum-label">状态</text>
          <text class="split-sum-value split-sum-ok-value">已收齐</text>
        </view>
      </view>
    </view>
    </scroll-view>

    <!-- 金额输入面板 -->
    <view v-if="amountPanelShow" class="picker-mask" @click="closeAmountPanel">
      <view class="picker-panel" @click.stop="">
        <view class="panel-title-row">
          <text class="panel-title">{{ amountRow != null ? methodName(amountRow.methodId) : '' }} 收款金额</text>
          <text class="panel-sub">应收 ¥{{ payableAmount.toFixed(2) }}</text>
        </view>
        <view class="amt-display-row">
          <text class="amt-display">{{ amtInput.length > 0 ? amtInput : '0.00' }}</text>
        </view>
        <view v-if="amountRemain > 0" class="amt-remain-hint">
          <text class="amt-remain-text">还可收 ¥{{ amountRemain.toFixed(2) }} 即结清</text>
        </view>
        <view v-else class="amt-remain-hint">
          <text class="amt-remain-text amt-remain-warn">已超过应收，会计算找零</text>
        </view>
        <view class="amt-quick-row">
          <view v-for="v in quickAmounts" :key="v" class="quick-chip quick-chip-small" @click="amtQuick(v)">
            <text class="quick-chip-text">¥{{ v }}</text>
          </view>
          <view class="quick-chip quick-chip-small quick-chip-exact" :class="{ 'quick-chip-disabled': !canAmtJust }" @click="amtJust">
            <text class="quick-chip-exact-text">刚好</text>
          </view>
        </view>
        <view class="amt-keypad">
          <view class="key" @click="pressAmtKey('1')"><text class="key-text">1</text></view>
          <view class="key" @click="pressAmtKey('2')"><text class="key-text">2</text></view>
          <view class="key" @click="pressAmtKey('3')"><text class="key-text">3</text></view>
          <view class="key key-func" @click="pressAmtBackspace"><text class="key-func-text">⌫</text></view>
          <view class="key" @click="pressAmtKey('4')"><text class="key-text">4</text></view>
          <view class="key" @click="pressAmtKey('5')"><text class="key-text">5</text></view>
          <view class="key" @click="pressAmtKey('6')"><text class="key-text">6</text></view>
          <view class="key key-func" @click="clearAmt"><text class="key-func-text">清空</text></view>
          <view class="key" @click="pressAmtKey('7')"><text class="key-text">7</text></view>
          <view class="key" @click="pressAmtKey('8')"><text class="key-text">8</text></view>
          <view class="key" @click="pressAmtKey('9')"><text class="key-text">9</text></view>
          <view class="key key-func" @click="closeAmountPanel"><text class="key-func-text">取消</text></view>
          <view class="key key-func" @click="pressAmtKey('.')"><text class="key-func-text">.</text></view>
          <view class="key" @click="pressAmtKey('0')"><text class="key-text">0</text></view>
          <view class="key" @click="pressAmtKey('00')"><text class="key-text">00</text></view>
          <view class="key key-confirm" @click="confirmAmount"><text class="key-confirm-text">确认</text></view>
        </view>
      </view>
    </view>

    <!-- 支付方式选择面板 -->
    <view v-if="methodPanelShow" class="picker-mask" @click="closeMethodPanel">
      <view class="picker-panel" @click.stop="">
        <view class="panel-title-row">
          <text class="panel-title">选择支付方式</text>
        </view>
        <view
          v-for="p in payments"
          :key="p.id"
          class="method-opt"
          :class="{ 'method-opt-on': methodRow != null && methodRow.methodId == p.id }"
          @click="pickMethod(p.id)"
        >
          <text class="method-opt-icon">{{ p.icon ?? '' }}</text>
          <text class="method-opt-name">{{ p.name }}</text>
          <view v-if="methodRow != null && methodRow.methodId == p.id" class="method-opt-check">
            <text class="method-opt-check-icon">✓</text>
          </view>
        </view>
        <view class="picker-close" @click="closeMethodPanel">
          <text class="picker-close-text">取消</text>
        </view>
      </view>
    </view>

    <!-- 底部支付栏 -->
    <view class="pay-bar">
      <view class="pay-bar-left">
        <text class="pay-bar-label">已收</text>
        <text class="pay-bar-amount">¥{{ receivedAmount.toFixed(2) }}</text>
        <text v-if="changeAmount > 0" class="pay-bar-change">找零 ¥{{ changeAmount.toFixed(2) }}</text>
        <text v-else-if="unpaidAmount > 0" class="pay-bar-unpaid">未收 ¥{{ unpaidAmount.toFixed(2) }}</text>
      </view>
      <view class="pay-btn" :class="{ 'pay-btn-disabled': !canPay || paying }" @click="doSettle">
        <text class="pay-btn-text">{{ paying ? '处理中...' : '确认支付' }}</text>
      </view>
    </view>
  </view>
</template>

<script>
  import { fetchOrderDetail, settleOrder, type OrderItem, type SettleOrderDto, type SettlePaymentLine } from '../../api/orders.uts'
  import { toNum } from '../../utils/num.uts'
  import { fetchPayments, type PaymentMethod } from '../../api/payments.uts'
  import { printReceipt, getDefaultPrinter } from '../../utils/print-manager.uts'
  import type { ReceiptData, ReceiptItem } from '../../utils/esc-pos.uts'

  /** 结账优惠字段 */
  type DiscountFields = {
    amount: number
    type: string
    name: string
  }

  /** 拆分支付行：单行 = 一种支付方式的实收金额 */
  type SplitPayRow = {
    key: number
    methodId: number
    /** null = 自动补差（应收剩余由该行收齐，仅允许一行）；否则为该行实收金额（元） */
    amount: number | null
  }

  /** 整单折扣选项 */
  type DiscountOption = {
    key: string
    label: string
    value: number
  }

  export default {
    data() {
      return {
        statusBarHeight: 20,
        orderId: 0,
        order: null as OrderItem | null,
        payments: [] as PaymentMethod[],
        paying: false,
        /** 拆分支付行（默认一行自动补差 = 按应收整笔） */
        splitRows: [] as SplitPayRow[],
        rowKeySeq: 1,
        /** 金额输入面板 */
        amountPanelShow: false,
        amountRow: null as SplitPayRow | null,
        amtInput: '',
        /** 支付方式选择面板 */
        methodPanelShow: false,
        methodRow: null as SplitPayRow | null,
        /** 手动输入优惠金额（抹零等） */
        manualDiscount: 0,
        /** 快捷面额按钮 */
        quickAmounts: [10, 20, 50, 100],
        /** 整单折扣选项（百分比，90 = 9折） */
        discountOptions: [
          { key: 'd90', label: '9折', value: 90 },
          { key: 'd88', label: '8.8折', value: 88 },
          { key: 'd80', label: '8折', value: 80 }
        ] as DiscountOption[],
        /** 当前选中折扣（0 = 无） */
        discountPercent: 0,
        discountPanelVisible: false,
        customDiscountText: '',
        customDiscountReason: ''
      }
    },
    computed: {
      /** 折扣优惠额（基于菜品合计计算，与抹零可叠加） */
      percentOffAmount(): number {
        if (this.discountPercent <= 0 || !this.order) return 0
        const off = this.order.total_amount * (1 - this.discountPercent / 100)
        return Math.round(off * 100) / 100
      },
      discountAmount(): number {
        // 订单已有优惠 + 折扣 + 手动抹零
        const existing = this.order ? (this.order.discount_amount ?? 0) : 0
        return existing + this.percentOffAmount + this.manualDiscount
      },
      /** 优惠名称快照（展示 / 下发用） */
      discountNameText(): string {
        const parts: string[] = []
        if (this.percentOffAmount > 0) {
          parts.push(this.activeDiscountName)
        }
        if (this.manualDiscount > 0) {
          parts.push('抹零')
        }
        return parts.join('+')
      },
      customDiscountRate(): number {
        return toNum(this.customDiscountText)
      },
      activeDiscountName(): string {
        if (this.discountPercent % 10 == 0) {
          return '手动' + (this.discountPercent / 10) + '折'
        }
        return '手动' + this.customDiscountSummary
      },
      customDiscountHint(): string {
        if (this.customDiscountText.length == 0) return '请输入 5.0-9.9 折（一位小数）'
        if (this.customDiscountRate <= 0) return '折扣率格式不正确'
        const dotIndex = this.customDiscountText.indexOf('.')
        if (dotIndex >= 0 && this.customDiscountText.length - dotIndex - 1 > 1) return '折扣率最多一位小数'
        if (this.customDiscountRate < 50 || this.customDiscountRate > 99) return '折扣率需为 5.0-9.9 折'
        return '原因最长 12 字，可留空'
      },
      canApplyCustomDiscount(): boolean {
        const rate = this.customDiscountRate
        const dotIndex = this.customDiscountText.indexOf('.')
        const decimalValid = dotIndex < 0 || this.customDiscountText.length - dotIndex - 1 <= 1
        return this.customDiscountText.length > 0 && decimalValid && rate >= 50 && rate <= 99
      },
      customDiscountSummary(): string {
        return (this.discountPercent / 10).toFixed(1) + '折' + (this.customDiscountReason.length > 0 ? '·' + this.customDiscountReason : '')
      },
      payableAmount(): number {
        if (!this.order) return 0
        const amt = this.order.total_amount - this.discountAmount
        return amt > 0 ? amt : 0
      },
      /** 各支付行已填实收合计（不含自动行） */
      concreteReceived(): number {
        let s = 0
        const rows = this.splitRows
        for (let i = 0; i < rows.length; i++) {
          const a = rows[i].amount
          if (a != null) s += a
        }
        return Math.round(s * 100) / 100
      },
      /** 是否存在自动补差行（amount == null：自动吃剩余差额） */
      hasAutoRow(): boolean {
        const rows = this.splitRows
        for (let i = 0; i < rows.length; i++) {
          if (rows[i].amount == null) return true
        }
        return false
      },
      /** 是否存在待输入行（amount == 0：刚添加未填金额） */
      hasPendingRow(): boolean {
        const rows = this.splitRows
        for (let i = 0; i < rows.length; i++) {
          if (rows[i].amount != null && rows[i].amount == 0) return true
        }
        return false
      },
      /**
       * 自动行应收差额：应收 - 已填合计。
       * 自动行唯一（<=1 个 null），差额为其应收金额；超收/被填满时 0。
       */
      autoFillAmount(): number {
        if (!this.hasAutoRow) return 0
        const d = this.payableAmount - this.concreteReceived
        return d > 0 ? Math.round(d * 100) / 100 : 0
      },
      /** 已收合计 = 已填金额 + 自动行补差 */
      receivedAmount(): number {
        const s = this.concreteReceived + this.autoFillAmount
        return Math.round(s * 100) / 100
      },
      /** 未收余额（应收 - 已收，收满为 0） */
      unpaidAmount(): number {
        const u = this.payableAmount - this.receivedAmount
        return u > 0 ? u : 0
      },
      /** 找零 = 已收 - 应收（已收大于应收时） */
      changeAmount(): number {
        const c = this.receivedAmount - this.payableAmount
        return c > 0 ? c : 0
      },
      /** 除当前金额面板所在行外，其余已填金额合计（自动行不计，因可被「刚好」覆盖） */
      othersExclRow(): number {
        if (this.amountRow == null) return this.concreteReceived
        let s = 0
        const rows = this.splitRows
        for (let i = 0; i < rows.length; i++) {
          const r = rows[i]
          if (r.key == this.amountRow.key) continue
          const a = r.amount
          if (a != null && a > 0) s += a
        }
        return Math.round(s * 100) / 100
      },
      /** 金额面板提示：本行还可收多少即结清 */
      amountRemain(): number {
        const remain = this.payableAmount - this.othersExclRow
        return Math.round(remain * 100) / 100
      },
      canAmtJust(): boolean {
        return this.amountRemain > 0
      },
      canAddRow(): boolean {
        return this.order != null && this.payments.length > 1 && this.splitRows.length < 6
      },
      canPay(): boolean {
        if (this.order == null || this.payments.length == 0 || this.paying) return false
        const rows = this.splitRows
        if (rows.length == 0) return false
        for (let i = 0; i < rows.length; i++) {
          if (rows[i].methodId <= 0) return false
          const a = rows[i].amount
          // 待输入行（0）不能结账
          if (a != null && a <= 0) return false
        }
        // 自动行仅在还有差额时有效；其余行已收满应收时自动行等于 0 无意义
        if (this.hasAutoRow && this.payableAmount > 0 && this.concreteReceived >= this.payableAmount) return false
        return this.unpaidAmount <= 0
      }
    },
    onLoad(options: OnLoadOptions) {
      const info = uni.getSystemInfoSync()
      this.statusBarHeight = info.statusBarHeight ?? 20
      const oidRaw = parseFloat(options['order_id'] ?? '')
      this.orderId = isNaN(oidRaw) ? 0 : oidRaw
    },
    onShow() {
      this.load()
    },
    methods: {
      async load() {
        try {
          this.order = await fetchOrderDetail(this.orderId)
          this.payments = await fetchPayments()
          // 默认一行：当前店铺首个启用支付方式 + 自动补差（= 整笔按应收结算）
          if (this.splitRows.length == 0 && this.payments.length > 0) {
            const row: SplitPayRow = {
              key: this.rowKeySeq++,
              methodId: this.payments[0].id,
              amount: null,
            } as SplitPayRow
            this.splitRows.push(row)
          }
        } catch (e) {
          uni.showToast({ title: (e.message as string) ?? '', icon: 'none' })
        }
      },
      /** 结账成功后异步打印小票（fire-and-forget） */
      async autoPrintReceipt(settledOrder: OrderItem) {
        const printer = await getDefaultPrinter()
        if (printer == null) return
        let shopName = '餐饮收银'
        try {
          const rawUser = uni.getStorageSync('user') as string
          const user = JSON.parse(rawUser) as UTSJSONObject
          shopName = (user['shopName'] as string) ?? '餐饮收银'
        } catch (_) {}
        const receiptItems: ReceiptItem[] = []
        for (let i = 0; i < settledOrder.items.length; i++) {
          const it = settledOrder.items[i]
          const item: ReceiptItem = {
            name: it.name,
            qty: it.qty,
            price: it.unit_price,
            subtotal: it.amount,
            spec: it.spec_name ?? '',
            remark: it.remark ?? ''
          }
          receiptItems.push(item)
        }
        const data: ReceiptData = {
          shopName: shopName,
          orderNo: settledOrder.order_no,
          tableNo: settledOrder.table_id != null ? '#' + settledOrder.table_id!.toString() : '',
          guests: settledOrder.guests ?? 0,
          createTime: settledOrder.created_at ?? '',
          settleTime: new Date().toLocaleString(),
          items: receiptItems,
          totalAmount: settledOrder.total_amount,
          paidAmount: settledOrder.paid_amount,
          discountAmount: settledOrder.discount_amount ?? 0,
          paymentMethod: settledOrder.payment_method_name ?? '',
          remark: settledOrder.remark ?? ''
        }
        const r = await printReceipt(data, printer)
        if (!r.success) {
          console.warn('自动打印失败:', r.message)
        }
      },
      goBack() {
        uni.navigateBack()
      },
      /* ---------- 拆分支付行操作 ---------- */

      /** 行展示名：找支付方式 */
      methodName(id: number): string {
        const ps = this.payments
        for (let i = 0; i < ps.length; i++) {
          if (ps[i].id == id) return ps[i].name
        }
        return ''
      },
      methodIcon(id: number): string {
        const ps = this.payments
        for (let i = 0; i < ps.length; i++) {
          if (ps[i].id == id) return (ps[i].icon ?? '').toString()
        }
        return ''
      },
      /** 行金额展示：null = 自动吃剩余差额；0 = 待输入；>0 = 具体金额 */
      rowAmountText(row: SplitPayRow): string {
        if (row.amount == null) {
          if (this.payableAmount <= 0) return '¥0.00'
          return '自动 ¥' + this.autoFillAmount.toFixed(2)
        }
        if (row.amount == 0) return '输入金额'
        return '¥' + row.amount.toFixed(2)
      },
      /**
       * 添加一行：
       * - 尚无自动行 → 新行 amount=null（自动吃剩余差额），无需填金额
       * - 已有自动行 → 新行 amount=0（待输入），立刻弹出金额面板强制录入；取消则移除
       */
      addRow() {
        if (!this.canAddRow) {
          if (this.payments.length <= 1) {
            uni.showToast({ title: '仅一种支付方式，无需拆分', icon: 'none' })
          }
          return
        }
        const row: SplitPayRow = {
          key: this.rowKeySeq++,
          methodId: this.payments[0].id,
          amount: this.hasAutoRow ? 0 : null,
        } as SplitPayRow
        this.splitRows.push(row)
        if (row.amount == 0) {
          this.openAmountPanel(row)
        }
      },
      /** 删除一行（只剩一行时不可删） */
      removeRow(key: number) {
        if (this.splitRows.length <= 1) return
        // 关闭可能指向被删行的面板
        if (this.amountRow != null && this.amountRow.key == key) this.closeAmountPanel()
        if (this.methodRow != null && this.methodRow.key == key) this.closeMethodPanel()
        for (let i = 0; i < this.splitRows.length; i++) {
          if (this.splitRows[i].key == key) {
            this.splitRows.splice(i, 1)
            break
          }
        }
      },
      /** 打开支付方式选择面板（行下拉） */
      openMethodPanel(row: SplitPayRow) {
        this.methodRow = row
        this.methodPanelShow = true
      },
      pickMethod(id: number) {
        if (this.methodRow == null) return
        this.methodRow.methodId = id
        this.closeMethodPanel()
      },
      closeMethodPanel() {
        this.methodPanelShow = false
        this.methodRow = null
      },
      /** 点行金额区：打开金额输入面板（task-t13 同款遮罩 + 数字键盘） */
      openAmountPanel(row: SplitPayRow) {
        this.amountRow = row
        const a = row.amount
        this.amtInput = a == null || a == 0 ? '' : a.toString()
        this.amountPanelShow = true
      },
      closeAmountPanel() {
        const row = this.amountRow
        this.amountPanelShow = false
        this.amountRow = null
        this.amtInput = ''
        // 取消且该行仍是「待输入(0)」→ 撤掉刚添加的空行（自动行 null 除外）
        if (row != null && row.amount != null && row.amount == 0 && this.splitRows.length > 1) {
          for (let i = 0; i < this.splitRows.length; i++) {
            if (this.splitRows[i].key == row.key) {
              this.splitRows.splice(i, 1)
              break
            }
          }
        }
      },
      /** 金额键盘：追加字符（最多两位小数，长度保护） */
      pressAmtKey(k: string) {
        let cur = this.amtInput
        if (cur == '' && (k == '0' || k == '00')) {
          this.amtInput = '0'
          return
        }
        if (cur.length == 0 && k == '.') {
          this.amtInput = '0.'
          return
        }
        if (k == '.') {
          if (cur.indexOf('.') >= 0) return
          this.amtInput = cur + '.'
          return
        }
        const dotIdx = cur.indexOf('.')
        if (dotIdx >= 0 && cur.length - dotIdx - 1 >= 2) return
        if (cur.length >= 8) return
        // 已有 0 且无小数点时数字替换前导 0
        if (cur == '0') {
          this.amtInput = k
          return
        }
        this.amtInput = cur + k
      },
      pressAmtBackspace() {
        if (this.amtInput.length > 0) {
          this.amtInput = this.amtInput.substring(0, this.amtInput.length - 1)
        }
      },
      clearAmt() {
        this.amtInput = ''
      },
      /** 快捷面额（面板内）：直接填入，超收找零由汇总实时提示 */
      amtQuick(v: number) {
        this.amtInput = v.toString()
      },
      /** 「刚好」：本行收剩余应收差额，结清 */
      amtJust() {
        if (!this.canAmtJust) return
        const rem = this.amountRemain
        this.amtInput = rem.toString()
      },
      /** 确认金额：>0、不超应收太多；写入该行；可选把该行转为自动补差？——不，直接写金额 */
      confirmAmount() {
        if (this.amountRow == null) return
        const v = toNum(this.amtInput)
        if (this.amtInput.length == 0 || v <= 0) {
          uni.showToast({ title: '金额需大于 0', icon: 'none' })
          return
        }
        this.amountRow.amount = Math.round(v * 100) / 100
        this.closeAmountPanel()
      },
      /** 抹零开关：抹至整数元（去掉角分）；再点一次取消 */
      toggleMolin() {
        if (this.manualDiscount > 0) {
          this.manualDiscount = 0
          return
        }
        const amt = this.payableAmount
        const molin = amt - Math.floor(amt)
        if (molin > 0) {
          this.manualDiscount = Math.round(molin * 100) / 100
        } else {
          uni.showToast({ title: '金额已是整数，无需抹零', icon: 'none' })
        }
      },
      /** 整单折扣开关（再点一次取消） */
      toggleDiscount(p: number) {
        this.discountPercent = this.discountPercent == p ? 0 : p
      },
      toggleDiscountPanel() {
        this.discountPanelVisible = !this.discountPanelVisible
      },
      applyCustomDiscount() {
        if (!this.canApplyCustomDiscount) {
          uni.showToast({ title: this.customDiscountHint, icon: 'none' })
          return
        }
        const rate = this.customDiscountRate
        const text = rate.toFixed(1)
        this.customDiscountText = text
        this.discountPercent = rate
        this.discountPanelVisible = false
        uni.showToast({ title: '已应用自定义折扣', icon: 'none' })
      },
      /**
       * 组装优惠参数：打折 + 抹零可叠加。
       * 只有打折 → discount；只有抹零 → price_change；两者都有 → discount（名称合并）。
       */
      buildDiscountFields(): DiscountFields | null {
        const total = this.percentOffAmount + this.manualDiscount
        if (total <= 0) {
          return null
        }
        if (this.percentOffAmount > 0) {
          return { amount: total, type: 'discount', name: this.discountNameText } as DiscountFields
        }
        return { amount: total, type: 'price_change', name: '抹零' } as DiscountFields
      },
      async doSettle() {
        if (!this.canPay) {
          if (this.hasPendingRow) {
            uni.showToast({ title: '请为每行填写收款金额', icon: 'none' })
          } else if (this.unpaidAmount > 0) {
            uni.showToast({ title: '还有未收 ¥' + this.unpaidAmount.toFixed(2) + '，请补足', icon: 'none' })
          } else if (this.hasAutoRow && this.payableAmount > 0 && this.concreteReceived >= this.payableAmount) {
            uni.showToast({ title: '自动补差行已无差额，请删除或改金额', icon: 'none' })
          } else {
            uni.showToast({ title: '当前不可结账', icon: 'none' })
          }
          return
        }
        if (this.paying) return
        this.paying = true
        try {
          const df = this.buildDiscountFields()
          const dto: SettleOrderDto = {} as SettleOrderDto
          if (df != null) {
            dto.discount_amount = df.amount
            dto.discount_type = df.type
            dto.discount_name = df.name
          }
          // 单行 → 走旧单支付字段（兼容，不含 payments）；多行 → payments 拆分
          if (this.splitRows.length <= 1) {
            const row = this.splitRows[0]
            dto.payment_method_id = row.methodId
            dto.paid_amount = row.amount == null ? this.payableAmount : row.amount
          } else {
            const lines: SettlePaymentLine[] = []
            const rows = this.splitRows
            for (let i = 0; i < rows.length; i++) {
              const row = rows[i]
              let amt = row.amount
              if (amt == null) amt = this.autoFillAmount
              if (amt > 0) {
                const line: SettlePaymentLine = {
                  payment_method_id: row.methodId,
                  amount: amt,
                } as SettlePaymentLine
                lines.push(line)
              }
            }
            dto.payments = lines
            dto.paid_amount = this.receivedAmount
          }
          const settle = await settleOrder(this.orderId, dto)

          uni.showToast({
            title: this.changeAmount > 0 ? ('支付成功，找零 ¥' + this.changeAmount.toFixed(2)) : '支付成功',
            icon: 'none'
          })

          // 异步打印小票（fire-and-forget，不阻塞结账流程）
          this.autoPrintReceipt(settle)

          // 延迟后返回主页（桌台已释放）
          setTimeout(() => {
            uni.reLaunch({ url: '/pages/tables/index' })
          }, 1000)
        } catch (e) {
          uni.showToast({ title: (e.message as string) ?? '', icon: 'none' })
        } finally {
          this.paying = false
        }
      }
    }
  }
</script>

