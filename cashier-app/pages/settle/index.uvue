  }

  /* 金额展示与提示 */
  .amt-display-row {
    margin-top: 20rpx;
    height: 88rpx;
    background-color: #f5f6f8;
    border-radius: 12rpx;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0 24rpx;
  }

  .amt-display {
    font-size: 44rpx;
    font-weight: bold;
    color: #333333;
  }

  .amt-remain-hint {
    margin-top: 12rpx;
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
  }

  .amt-remain-text {
    font-size: 24rpx;
