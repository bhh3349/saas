<template>
  <view class="page">
    <!-- 顶部 -->
    <view class="nav" :style="{ paddingTop: statusBarHeight + 'px' }">
      <view class="nav-inner">
        <view class="nav-back" @click="goBack">
          <text class="back-icon">‹</text>
          <text class="back-text">返回</text>
        </view>
        <text class="nav-title">添加打印机</text>
        <view style="width: 120px;"></view>
      </view>
    </view>

    <!-- 连接方式切换 -->
    <view class="type-tabs">
      <view
        class="type-tab"
        :class="{ 'type-active': type == 'bluetooth' }"
        @click="switchType('bluetooth')"
      >
        <text class="tab-text">蓝牙</text>
      </view>
      <view
        class="type-tab"
        :class="{ 'type-active': type == 'wifi' }"
        @click="switchType('wifi')"
      >
        <text class="tab-text">WiFi</text>
      </view>
    </view>

    <!-- 蓝牙：设备搜索 -->
    <view v-if="type == 'bluetooth'" class="bt-section">
      <view class="section-head">
        <text class="section-title">附近蓝牙打印机</text>
        <view class="scan-btn" @click="startScan">
          <text class="scan-text">{{ scanning ? '搜索中...' : '重新搜索' }}</text>
        </view>
      </view>

      <scroll-view class="bt-list" scroll-y>
        <view v-if="!adapterOpen" class="bt-empty">
          <text class="empty-hint">蓝牙不可用</text>
          <text class="empty-sub">请开启蓝牙并允许「附近设备」权限后重试</text>
          <view class="hint-btn" @click="startScan">
            <text class="hint-text">重新检查并搜索</text>
          </view>
        </view>
        <view v-else-if="scanning && devices.length == 0" class="bt-empty">
          <text class="empty-hint">正在搜索附近设备...</text>
        </view>
        <view v-else-if="devices.length == 0" class="bt-empty">
          <text class="empty-hint">未发现蓝牙打印机</text>
          <text class="empty-sub">请确认打印机已开机且处于可发现模式</text>
        </view>
        <view
          v-for="d in devices"
          :key="d.mac"
          class="bt-item"
          @click="selectBt(d)"
        >
          <view class="bt-icon">
            <text class="icon-t">B</text>
          </view>
          <view class="bt-info">
            <text class="bt-name">{{ d.name.length > 0 ? d.name : '未知设备' }}</text>
            <text class="bt-id">{{ d.mac }}</text>
          </view>
          <text :class="d.bonded ? 'bt-bonded' : 'bt-unbonded'">{{ d.bonded ? '已配对' : '未配对' }}</text>
        </view>
      </scroll-view>

      <view class="manual-row">
        <text class="manual-label">手动输入</text>
        <input
          class="manual-input"
          placeholder="MAC 地址（AA:BB:CC:DD:EE:FF）"
          v-model="address"
        />
      </view>
    </view>

    <!-- WiFi：手动填写 -->
    <view v-else class="wifi-section">
      <view class="form-item">
        <text class="form-label">打印机 IP</text>
        <input
          class="form-input"
          placeholder="如 192.168.1.88"
          v-model="address"
        />
      </view>
      <view class="form-item">
        <text class="form-label">端口</text>
        <input
          class="form-input"
          type="number"
          placeholder="9100（热敏打印机默认）"
          v-model="portStr"
        />
      </view>
      <view class="ip-guide">
        <view class="ip-guide-head" @click="showIpGuide = !showIpGuide">
          <text class="ip-guide-title">不知道打印机 IP？点此查看获取方法</text>
          <text class="ip-guide-arrow">{{ showIpGuide ? '▲' : '▼' }}</text>
        </view>
        <view v-if="showIpGuide" class="ip-guide-body">
          <text class="ip-guide-step">1. 打印机关机</text>
          <text class="ip-guide-step">2. 长按进纸（FEED）键同时开机，保持 3-5 秒后松手</text>
          <text class="ip-guide-step">3. 打印机自动出一张小票，上面印有 IP address，填入上方即可</text>
        </view>
      </view>
      <view class="hint-box">
        <text class="hint-main">💡 提示</text>
        <text class="hint-line">热敏打印机（芯烨/飞鹅/佳博等）默认通过 9100 端口</text>
        <text class="hint-line">确保收银机和打印机在同一局域网</text>
      </view>
    </view>

    <!-- 公共表单 -->
    <view class="form-section">
      <view class="form-item">
        <text class="form-label">打印机名称</text>
        <input
          class="form-input"
          placeholder="如 前台小票机"
          v-model="name"
        />
      </view>
      <view class="form-item">
        <text class="form-label">品牌（可选）</text>
        <input
          class="form-input"
          placeholder="芯烨 / 飞鹅 / 佳博 / 商米"
          v-model="brand"
        />
      </view>
      <view class="form-item">
        <text class="form-label">纸宽</text>
        <view class="width-row">
          <view
            v-for="w in widths"
            :key="w"
            class="width-opt"
                :class="{ 'width-active': widthMM == w }"
            @click="widthMM = w"
          >
            <text class="width-text">{{ w }}mm</text>
          </view>
        </view>
      </view>
      <view class="form-item">
        <text class="form-label">备注（可选）</text>
        <input
          class="form-input"
          placeholder="如 前台右侧 / 荤菜档"
          v-model="remark"
        />
      </view>
      <view class="form-item switch-item">
        <text class="form-label">设为默认打印机</text>
        <switch :checked="isDefault" @change="onSwitch" />
      </view>
    </view>

    <!-- 底部保存 -->
    <view class="footer">
      <view class="save-btn" @click="save">
        <text class="save-text">保存</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { createPrinter, type CreatePrinterInput } from '../../api/printers.uts'
  import {
    ensureBluetoothReady,
    scanBluetoothDevices,
    getPairedBluetooth,
    type BluetoothDeviceInfo,
  } from '../../uni_modules/saas-printer/utssdk/index.uts'

  const statusBarHeight = ref(uni.getSystemInfoSync().statusBarHeight ?? 20)

  const type = ref<string>('bluetooth')
  const name = ref<string>('')
  const brand = ref<string>('')
  const remark = ref<string>('')
  const address = ref<string>('')
  const portStr = ref<string>('9100')
  const widthMM = ref<number>(80)
  const isDefault = ref<boolean>(false)
  const showIpGuide = ref<boolean>(false)
  const widths = [58, 80, 110]

  // 蓝牙相关
  const adapterOpen = ref<boolean>(false)
  const scanning = ref<boolean>(false)
  const devices = ref<BluetoothDeviceInfo[]>([])

  // 页面打开即做一次蓝牙就绪检查（Android 12+ 会触发系统权限弹窗，属预期交互）
  ensureBluetoothReady().then((msg: string) => {
    adapterOpen.value = msg.length == 0
  })

  function switchType(t: string) {
    type.value = t
    // 切换到 WiFi 默认端口 9100，蓝牙不填端口
    if (t == 'wifi' && !portStr.value) portStr.value = '9100'
  }

  function goBack() {
    uni.navigateBack()
  }

  function onSwitch(e: UniSwitchChangeEvent) {
    isDefault.value = e.detail.value
  }

  /**
   * 蓝牙设备搜索：先做权限 / 开关就绪检查，再「已配对设备 + 附近扫描」合并展示。
   * 扫描走原生经典蓝牙发现（约 12s），结束后自动停止。
   */
  async function startScan() {
    if (scanning.value) {
      return
    }
    scanning.value = true
    devices.value = []
    try {
      const msg = await ensureBluetoothReady()
      if (msg.length > 0) {
        adapterOpen.value = false
        scanning.value = false
        uni.showToast({ title: msg, icon: 'none' })
        return
      }
      adapterOpen.value = true
      // 已配对设备先展示，扫描结果稍后合并
      devices.value = getPairedBluetooth()
      const found = await scanBluetoothDevices()
      for (let i = 0; i < found.length; i++) {
        const f = found[i]
        let exists = false
        for (let j = 0; j < devices.value.length; j++) {
          if (devices.value[j].mac == f.mac) {
            exists = true
            break
          }
        }
        if (!exists) {
          devices.value.push(f)
        }
      }
      scanning.value = false
    } catch (e) {
      scanning.value = false
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    }
  }

  function selectBt(d: BluetoothDeviceInfo) {
    address.value = d.mac
    // 未填名称时用设备名补齐
    if (name.value == '' && d.name.length > 0) {
      name.value = d.name
    }
    if (d.bonded) {
      uni.showToast({ title: '已选择: ' + (d.name.length > 0 ? d.name : d.mac), icon: 'success' })
    } else {
      uni.showToast({ title: '已选择未配对设备，连接时会弹出配对确认', icon: 'none' })
    }
  }

  function save() {
    if (name.value == '') {
      uni.showToast({ title: '请填写打印机名称', icon: 'none' })
      return
    }
    if (address.value == '') {
      uni.showToast({ title: type.value == 'bluetooth' ? '请选择蓝牙设备' : '请填写 IP 地址', icon: 'none' })
      return
    }

    const dto: CreatePrinterInput = {
      name: name.value,
      type: type.value,
      address: address.value,
      brand: brand.value,
      width_mm: widthMM.value,
      remark: remark.value,
      is_default: isDefault.value,
    }
    if (type.value == 'wifi') {
      const p = parseInt(portStr.value, 10)
      dto.port = isNaN(p) ? 9100 : p
    }

    createPrinter(dto)
      .then(() => {
        uni.showToast({ title: '保存成功', icon: 'success' })
        setTimeout(() => {
          uni.navigateBack()
        }, 800)
      })
      .catch((e) => {
        uni.showToast({ title: (e as Error).message, icon: 'none' })
      })
  }
</script>

