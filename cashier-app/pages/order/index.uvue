    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.9);
    margin-right: 6rpx;
  }

  .guests-num {
    font-size: 26rpx;
    color: #ffffff;
    font-weight: bold;
  }

  /* 搜索框 */
  .search-bar {
    padding: 20rpx 24rpx 0;
  }

  .search-box {
    display: flex;
    flex-direction: row;
