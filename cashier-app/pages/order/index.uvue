<template>
  <view class="page">
    <!-- 顶部导航 -->
    <view class="nav" :style="{ paddingTop: statusBarHeight + 'px' }">
      <view class="nav-inner">
        <view class="nav-back" @click="goBack">
          <text class="back-icon">←</text>
        </view>
        <text class="nav-title">{{ navTitle }}</text>
        <view class="nav-right-placeholder"></view>
      </view>
    </view>

    <!-- 搜索框 -->
    <view class="search-bar">
      <view class="search-box">
        <text class="search-icon">🔍</text>
        <input class="search-input" v-model="keyword" placeholder="搜索菜品名 / 助记码" confirm-type="search" />
      </view>
    </view>

    <!-- 主体：左分类 + 右菜品 -->
    <view class="main">
      <!-- 左侧分类（搜索时隐藏） -->
      <scroll-view v-if="!keyword" class="cate-scroll" scroll-y>
        <view
          v-for="c in categories"
          :key="c"
          class="cate-item"
          :class="activeCategory == c ? 'cate-on' : ''"
          @click="activeCategory = c"
        >
          <text class="cate-label" :class="activeCategory == c ? 'cate-on-label' : ''">{{ c }}</text>
        </view>
      </scroll-view>

      <!-- 右侧菜品 -->
      <scroll-view class="dish-scroll" scroll-y>
        <view v-if="filteredDishes.length == 0" class="empty">
          <text class="empty-label">暂无菜品</text>
        </view>
        <view
          v-for="d in filteredDishes"
          :key="d.id"
          class="dish-row"
          :class="{ 'dish-sold': d.sold_out }"
        >
          <view class="dish-info">
            <view class="dish-name-row">
              <text class="dish-name" :class="{ 'dish-name-gray': d.sold_out }">{{ d.name }}</text>
              <text v-if="d.sold_out" class="sold-out-tag">沽清</text>
            </view>
              <text v-if="d.specs.length > 0" class="dish-spec">{{ specNames(d) }}</text>
            <view class="dish-price-row">
              <text class="dish-price" :class="{ 'dish-price-gray': d.sold_out }">¥{{ linePrice(d, -1).toFixed(2) }}</text>
            </view>
          </view>
          <view class="dish-ops">
            <view v-if="cartCount(d.id) == 0">
              <view v-if="d.sold_out" class="btn-sold-disabled">
                <text class="btn-sold-text">沽清</text>
              </view>
              <view v-else>
                <view v-if="d.specs.length > 0" class="btn-choose" @click="addDishWithSpec(d)">
                  <text class="btn-choose-text">选择</text>
                </view>
                <view v-else class="btn-plus" @click="addDish(d, 0)">
                  <text class="btn-plus-text">+</text>
                </view>
              </view>
            </view>
            <view v-else>
              <view class="btn-minus" @click="minusDish(d)">
                <text class="btn-minus-text">−</text>
              </view>
              <text class="qty-num">{{ cartCount(d.id) }}</text>
              <view
                class="btn-plus"
                :class="{ 'btn-plus-disabled': d.sold_out }"
                @click="addDishCurrent(d)"
              >
                <text class="btn-plus-text">+</text>
              </view>
            </view>
          </view>
        </view>
        <view class="dish-bottom-space"></view>
      </scroll-view>
    </view>

    <!-- 底部购物车栏 -->
    <view v-if="!cartEmpty" class="cart-bar">
      <view class="cart-left" @click="showCartDetail">
        <view class="cart-icon-wrap">
          <text class="cart-icon">🛒</text>
          <view class="cart-badge">
            <text class="cart-badge-text">{{ totalCount }}</text>
          </view>
        </view>
        <view class="cart-amount-wrap">
          <text class="cart-total">¥{{ totalAmount.toFixed(2) }}</text>
          <text class="cart-count-label">已点 {{ totalCount }} 个菜品</text>
        </view>
      </view>
      <view class="cart-right" @click="goCart">
        <text class="cart-go-text">去购物车</text>
      </view>
    </view>
    <view v-else class="cart-bar cart-bar-empty">
      <text class="cart-bar-hint">请先点菜</text>
    </view>

    <!-- 规格选择弹窗 -->
    <view v-if="specPickerShow" class="modal-mask" @click="specPickerShow = false">
      <view class="modal-content" @click.stop="">
        <text class="modal-title">{{ specPickerDish ? specPickerDish.name : '' }}</text>
        <text class="modal-sub">请选择规格</text>
        <view class="spec-list">
          <view
            v-for="(s, i) in specPickerDish ? specPickerDish.specs : []"
            :key="i"
            class="spec-item"
            @click="confirmSpec(i)"
          >
            <text class="spec-name">{{ s.name }}</text>
            <text class="spec-price">¥{{ (specPickerDish!.price + s.price_delta).toFixed(2) }}</text>
          </view>
        </view>
        <view class="modal-close" @click="specPickerShow = false">
          <text class="modal-close-text">取消</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script>
  import { fetchMenu, type DishItem } from '../../api/dishes.uts'
  import { toInt } from '../../utils/num.uts'

  /** 购物车条目 */
  type CartEntry = {
    key: string
    qty: number
  }

  export default {
    data() {
      return {
        statusBarHeight: 20,
        tableId: 0,
        tableName: '',
        orderId: 0,
        guests: 0,
        keyword: '',
        dishes: [] as DishItem[],
        categories: [] as string[],
        activeCategory: '',
        cart: [] as CartEntry[],
        specPickerShow: false,
        specPickerDish: null as DishItem | null
      }
    },
    computed: {
      navTitle(): string {
        if (this.tableId > 0) {
          return this.tableName + (this.guests > 0 ? ' (' + this.guests + '人)' : '')
        }
        return '点餐'
      },
      filteredDishes(): DishItem[] {
        const kw = this.keyword.trim().toLowerCase()
        let list = this.dishes
        if (this.activeCategory) {
          list = list.filter((d: DishItem) => d.category == this.activeCategory)
        }
        if (kw) {
          list = list.filter((d: DishItem) => {
            const code = d.code ?? ''
            return d.name.toLowerCase().includes(kw) || (code.length > 0 && code.toLowerCase().includes(kw))
          })
        }
        return list
      },
      cartEmpty(): boolean {
        return this.totalCount == 0
      },
      totalCount(): number {
        let n = 0
        for (let i = 0; i < this.cart.length; i++) {
          n += this.cart[i].qty
        }
        return n
      },
      totalAmount(): number {
        let amt = 0
        for (let i = 0; i < this.cart.length; i++) {
          const entry = this.cart[i]
          const idx = entry.key.indexOf('_')
          const dishId = toInt(entry.key.substring(0, idx))
          const specIdx = toInt(entry.key.substring(idx + 1))
          const dish = this.findDish(dishId)
          if (dish != null) {
            amt += this.linePrice(dish, specIdx) * entry.qty
          }
        }
        return amt
      }
    },
    onLoad(options: OnLoadOptions) {
      const info = uni.getSystemInfoSync()
      this.statusBarHeight = info.statusBarHeight ?? 20
      const tidRaw = parseFloat(options['table_id'] ?? '')
      this.tableId = isNaN(tidRaw) ? 0 : tidRaw
      this.tableName = options['table_name'] ?? ''
      const oidRaw = parseFloat(options['order_id'] ?? '')
      this.orderId = isNaN(oidRaw) ? 0 : oidRaw
      const gRaw = parseFloat(options['guests'] ?? '')
      this.guests = isNaN(gRaw) ? 0 : gRaw
      const saved = uni.getStorageSync('cashier_cart')
      if (saved && typeof saved == 'object') {
        const savedItems = saved as Array<UTSJSONObject>
        for (let i = 0; i < savedItems.length; i++) {
          const item = savedItems[i]
          this.cart.push({
            key: (item['key'] ?? '').toString(),
            qty: toInt((item['qty'] ?? 0).toString()),
          } as CartEntry)
        }
      }
    },
    onShow() {
      this.load()
    },
    onHide() {
      this.persistCart()
    },
    methods: {
      async load() {
        try {
          const list = await fetchMenu()
          const sorted = list.sort((a: DishItem, b: DishItem) => {
          if (a.sort_order != b.sort_order) return a.sort_order - b.sort_order
            return a.id - b.id
          })
          this.dishes = sorted
          const seen: string[] = []
          const cats: string[] = []
          for (let i = 0; i < sorted.length; i++) {
            const c = sorted[i].category ?? ''
            if (!seen.includes(c)) {
              seen.push(c)
              cats.push(c)
            }
          }
          this.categories = cats
          if (!this.categories.includes(this.activeCategory)) {
            this.activeCategory = this.categories.length > 0 ? this.categories[0] : ''
          }
        } catch (e) {
          uni.showToast({ title: (e.message as string) ?? '', icon: 'none' })
        }
      },
      getCartQty(dishId: number): number {
        const prefix = dishId.toString() + '_'
        let n = 0
        for (let i = 0; i < this.cart.length; i++) {
          if (this.cart[i].key.startsWith(prefix)) {
            n += this.cart[i].qty
          }
        }
        return n
      },
      currentSpecIndex(dishId: number): number {
        const prefix = dishId.toString() + '_'
        for (let i = 0; i < this.cart.length; i++) {
          if (this.cart[i].key.startsWith(prefix)) {
            const idx = this.cart[i].key.indexOf('_')
            return toInt(this.cart[i].key.substring(idx + 1))
          }
        }
        return 0
      },
      persistCart() {
        uni.setStorageSync('cashier_cart', this.cart)
      },
      findDish(id: number): DishItem | null {
        for (let i = 0; i < this.dishes.length; i++) {
          if (this.dishes[i].id == id) return this.dishes[i]
        }
        return null
      },
      linePrice(d: DishItem, specIndex: number): number {
        if (specIndex >= 0 && specIndex < d.specs.length) {
          return d.price + d.specs[specIndex].price_delta
        }
        return d.price
      },
      goBack() {
        this.persistCart()
        uni.navigateBack()
      },
      cartCount(dishId: number): number {
        return this.getCartQty(dishId)
      },
      addDishWithSpec(d: DishItem) {
        this.specPickerDish = d
        this.specPickerShow = true
      },
      addDishCurrent(d: DishItem) {
        this.addDish(d, this.currentSpecIndex(d.id))
      },
      confirmSpec(specIndex: number) {
        if (this.specPickerDish != null) {
          this.addDish(this.specPickerDish!, specIndex)
        }
        this.specPickerShow = false
      },
      addDish(d: DishItem, specIndex: number) {
        if (d.sold_out) {
          uni.showToast({ title: d.name + ' 已沽清', icon: 'none' })
          return
        }
        const key = d.id.toString() + '_' + specIndex.toString()
        let found = false
        for (let i = 0; i < this.cart.length; i++) {
          if (this.cart[i].key == key) {
            this.cart[i].qty++
            found = true
            break
          }
        }
        if (!found) {
          this.cart.push({ key: key, qty: 1 })
        }
        this.persistCart()
      },
      minusDish(d: DishItem) {
        const prefix = d.id.toString() + '_'
        for (let i = 0; i < this.cart.length; i++) {
          if (this.cart[i].key.startsWith(prefix)) {
            this.cart[i].qty--
            if (this.cart[i].qty <= 0) {
              this.cart.splice(i, 1)
            }
            break
          }
        }
        this.persistCart()
      },
      specNames(d: DishItem): string {
        const names: string[] = []
        for (let i = 0; i < d.specs.length; i++) {
          names.push(d.specs[i].name)
        }
        return names.join(' / ')
      },
      goCart() {
        this.persistCart()
        let url = '/pages/cart/index'
        const qs: string[] = []
        if (this.tableId > 0) qs.push('table_id=' + this.tableId.toString())
        if (this.tableName) qs.push('table_name=' + this.tableName)
        if (this.orderId > 0) qs.push('order_id=' + this.orderId.toString())
        if (this.guests > 0) qs.push('guests=' + this.guests.toString())
        if (qs.length > 0) url += '?' + qs.join('&')
        uni.navigateTo({ url: url })
      },
      showCartDetail() {
        this.goCart()
      }
    }
  }
</script>

<style>
