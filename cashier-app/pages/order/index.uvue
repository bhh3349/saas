    font-weight: bold;
  }

  .dish-scroll {
    flex: 1;
    background-color: #ffffff;
  }

  .dish-row {
    display: flex;
    flex-direction: row;
    padding: 24rpx;
    border-bottom-width: 1rpx;
    border-bottom-style: solid;
    border-bottom-color: #f0f0f0;
    align-items: center;
  }

  .dish-sold {
    opacity: 0.6;
  }

  .dish-info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

