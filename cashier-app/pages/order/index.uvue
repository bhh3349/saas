    display: flex;
    flex-direction: row;
    align-items: center;
    height: 88rpx;
    padding: 0 24rpx;
  }

  .nav-back {
    width: 80rpx;
    height: 60rpx;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .back-icon {
    font-size: 44rpx;
    color: #ffffff;
  }

